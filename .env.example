# Twelve Labs Multimodal AI API
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=
TWELVELABS_ENGINE=pegasus1.5

# Apify Instagram Discovery API
APIFY_API_TOKEN=
APIFY_INSTAGRAM_REELS_ACTOR=apify/instagram-search-scraper
APIFY_INSTAGRAM_REELS_ACTOR_INPUT_JSON={"search":"{query}","searchType":"popular","searchLimit":25}

# System Discovery Configuration
DISCOVERY_MODE=provider
INSTAGRAM_PROVIDER_ORDER=apify

# Limits
INSTAGRAM_MAX_RESULTS=100
APIFY_SEARCH_LIMIT=25
TWELVELABS_MAX_COMPETITORS=10

# Retries and Timeouts
TWELVELABS_RETRY_ATTEMPTS=2
TWELVELABS_REQUEST_DELAY_SECONDS=1
TWELVELABS_REQUEST_TIMEOUT_SECONDS=180

# Local Processing Tools (optional paths, defaults to system PATH)
FFMPEG_BIN=
TESSERACT_CMD=
WHISPER_MODEL=base
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
